<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
        xmlns:views="using:Dfs.Client.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="720"
        x:Class="Dfs.Client.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Centralized Distributed File System - Client"
        Width="1150" Height="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Noto Sans, Ubuntu, -apple-system, sans-serif">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileBrowserViewModel}">
            <views:FileBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransferManagerViewModel}">
            <views:TransferManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminPanelViewModel}">
            <views:AdminPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClusterStatusViewModel}">
            <views:ClusterStatusView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <!-- Unauthenticated State: Show Login directly -->
        <ContentControl Content="{Binding CurrentPage}"
                        IsVisible="{Binding IsNotLoggedIn}" />

        <!-- Authenticated State: Sidebar + Dynamic Main Content -->
        <Grid ColumnDefinitions="240,*" IsVisible="{Binding IsLoggedIn}">
            <!-- Left Sidebar Navigation -->
            <Border Grid.Column="0"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Brand / App Header -->
                    <Border Grid.Row="0" Padding="20,24">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🗄️" FontSize="26" VerticalAlignment="Center" />
                                <TextBlock Text="Centralized DFS"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Đồ án Hệ Thống Thông Tin - 7B"
                                       FontSize="11"
                                       Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>

                    <!-- Nav Buttons List -->
                    <StackPanel Grid.Row="1" Spacing="4" Margin="12,8">
                        <Button Content="📁  Tệp tin của tôi"
                                Command="{Binding NavigateFilesCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,10"
                                CornerRadius="6"
                                Background="{Binding IsFilesTab, Converter={x:Null}}"
                                Foreground="#F1F5F9"
                                FontSize="13"
                                FontWeight="SemiBold" />

                        <Button Content="🚀  Hàng đợi truyền tải"
                                Command="{Binding NavigateTransfersCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,10"
                                CornerRadius="6"
                                Foreground="#F1F5F9"
                                FontSize="13"
                                FontWeight="SemiBold" />

                        <Button Content="🛡️  Bảng quản trị"
                                Command="{Binding NavigateAdminCommand}"
                                IsVisible="{Binding IsAdmin}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,10"
                                CornerRadius="6"
                                Foreground="#F1F5F9"
                                FontSize="13"
                                FontWeight="SemiBold" />

                        <Button Content="📊  Trạng thái cụm (LAN)"
                                Command="{Binding NavigateClusterCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="16,10"
                                CornerRadius="6"
                                Foreground="#F1F5F9"
                                FontSize="13"
                                FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Bottom User Profile Card -->
                    <Border Grid.Row="2"
                            Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="0,1,0,0"
                            Padding="16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding UserDisplayName}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#F8FAFC"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="LAN 5 Laptop Cluster"
                                           FontSize="11"
                                           Foreground="#64748B" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Đăng xuất"
                                    Command="{Binding LogoutCommand}"
                                    Padding="8,4"
                                    FontSize="11"
                                    CornerRadius="4"
                                    Background="#334155"
                                    Foreground="#F8FAFC" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Main Work Area -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Background="#FFFFFF" />
        </Grid>
    </Grid>
</Window>
