<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Dfs.Client.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="#F0F4F8">
        <Border Width="460"
                Padding="36,32"
                Background="#FFFFFF"
                CornerRadius="8"
                BoxShadow="0 8 24 0 #20000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <!-- App Logo & Title -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="🗄️" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0066CC"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Centralized Distributed File System (DFS)"
                               FontSize="12"
                               Foreground="#6C757D"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Margin="0,2" Background="#DEE2E6" />

                <!-- Error Banner -->
                <Border Background="#F8D7DA"
                        BorderBrush="#F5C6CB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        IsVisible="{Binding HasError}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#721C24"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   MaxWidth="360" />
                    </StackPanel>
                </Border>

                <!-- Username Field -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Tên đăng nhập:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#212529" />
                    <TextBox Text="{Binding Username}"
                             PlaceholderText="Ví dụ: demo hoặc an.nguyen"
                             Height="36"
                             CornerRadius="4"
                             BorderBrush="#DEE2E6"
                             IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <!-- Password Field -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Mật khẩu:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#212529" />
                    <TextBox Text="{Binding Password}"
                             PlaceholderText="••••••••"
                             PasswordChar="•"
                             Height="36"
                             CornerRadius="4"
                             BorderBrush="#DEE2E6"
                             IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <!-- Metadata Server Endpoint Field -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Máy chủ Metadata:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#212529" />
                    <TextBox Text="{Binding Endpoint}"
                             PlaceholderText="127.0.0.1:7000"
                             Height="36"
                             CornerRadius="4"
                             BorderBrush="#DEE2E6"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <!-- Remember Me Checkbox -->
                <CheckBox Content="Ghi nhớ tên đăng nhập trên máy này"
                          IsChecked="{Binding RememberMe}"
                          FontSize="12"
                          Foreground="#495057"
                          IsEnabled="{Binding !IsBusy}" />

                <!-- Submit Button -->
                <Button Content="ĐĂNG NHẬP"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Height="40"
                        Background="#0066CC"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        CornerRadius="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,4,0,0" />

                <!-- Loading Indicator -->
                <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                    <TextBlock Text="Đang kết nối tới máy chủ Metadata..."
                               FontSize="11"
                               Foreground="#0066CC"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" />
                </StackPanel>

                <!-- Hint -->
                <TextBlock Text="💡 Gợi ý thử nghiệm: tài khoản 'demo' / mật khẩu 'demo'"
                           FontSize="11"
                           Foreground="#6C757D"
                           FontStyle="Italic"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
