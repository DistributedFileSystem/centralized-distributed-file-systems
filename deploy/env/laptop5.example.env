# Copy to deploy/env/laptop5.env and replace placeholders before running.
# Never commit deploy/env/laptop5.env (ignored by .gitignore).

# Laptop 5 runs Data Server only in Stage 1.
COMPOSE_PROFILES=data

# Bind published ports on all interfaces so peer laptops can connect.
BIND_HOST=0.0.0.0

# Static LAN IP of Laptop 5 advertised to Metadata Server and clients.
ADVERTISE_HOST=192.168.10.15

# Data Server settings
DATA_NODE_ID=ds-5
DATA_LISTEN_PORT=7001

# Metadata Server endpoint(s) (Laptop 1 in Stage 1)
METADATA_ENDPOINTS=192.168.10.11:7000

# Shared HMAC key for data tokens (must match Laptop 1)
TOKEN_KEY=replace-with-shared-cluster-token-key

# Optional Data Server storage capacity limit in bytes (0 = auto/unlimited)
CAPACITY_BYTES=0
