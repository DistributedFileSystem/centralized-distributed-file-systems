<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             xmlns:m="using:Dfs.Client.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="Dfs.Client.Desktop.Views.AdminPanelView"
             x:DataType="vm:AdminPanelViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Background="#FFFFFF" Margin="24">
        <!-- 1. Header & Global Sync Action -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Bảng điều khiển Quản trị hệ thống (Admin Control Panel)"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0F172A" />
                <TextBlock Text="Quản lý vòng đời Người dùng (Users), Nhóm làm việc (Groups) và Chính sách phân quyền phân cấp (RBAC)"
                           FontSize="12"
                           Foreground="#64748B" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="🔄 Đồng bộ dữ liệu"
                    Command="{Binding RefreshCommand}"
                    Padding="14,8"
                    CornerRadius="6"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    FontSize="12"
                    FontWeight="SemiBold" />
        </Grid>

        <!-- 2. Status Notification Banner -->
        <Border Grid.Row="1"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,14"
                IsVisible="{Binding HasStatusMessage}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="#065F46"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding DismissStatusCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#065F46"
                        Padding="6,2" />
            </Grid>
        </Border>

        <!-- 3. Main Admin Subsystem Content (Controlled by Sidebar) -->
        <Panel Grid.Row="2">
            
            <!-- SECTION 1: USERS MANAGEMENT (BẢNG DANH SÁCH TÀI KHOẢN TOÀN DIỆN)  -->
            <Grid IsVisible="{Binding IsUsersTabSelected}" RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Actions Toolbar & Search -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*,260" VerticalAlignment="Center">
                            <Button Grid.Column="0"
                                    Content="➕ Tạo tài khoản mới"
                                    Command="{Binding OpenCreateUserDialogCommand}"
                                    Padding="14,7"
                                    Background="#0284C7"
                                    Foreground="#FFFFFF"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    FontSize="12" />

                            <TextBlock Grid.Column="1"
                                       Text="Mật khẩu người dùng được băm an toàn với PBKDF2-SHA256 kèm salt ngẫu nhiên."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding SearchUserQuery, Mode=TwoWay}"
                                     PlaceholderText="🔍 Tìm theo username..."
                                     Height="34"
                                     CornerRadius="6"
                                     BorderBrush="#CBD5E1"
                                     Padding="10,0"
                                     FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- Table Header -->
                    <Border Grid.Row="1"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6,6,0,0"
                            Padding="16,10">
                        <Grid ColumnDefinitions="2.5*,2*,2*,3*,2.5*">
                            <TextBlock Grid.Column="0" Text="Tài khoản (Username)" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="1" Text="Mã User ID" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="2" Text="Trạng thái" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="3" Text="Nhóm trực thuộc" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="4" Text="Thao tác" FontWeight="Bold" FontSize="12" Foreground="#334155" TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- User Items List (Full Width Table) -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredUsers}"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1,0,1,1"
                             CornerRadius="0,0,6,6"
                             Background="#FFFFFF">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:UiUserItem">
                                <Grid ColumnDefinitions="2.5*,2*,2*,3*,2.5*" VerticalAlignment="Center" Margin="0,6">
                                    <!-- Col 0: Username -->
                                    <TextBlock Grid.Column="0" Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />

                                    <!-- Col 1: ID -->
                                    <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

                                    <!-- Col 2: Status Pill Badge -->
                                    <Border Grid.Column="2"
                                            Background="{Binding Disabled, Converter={x:Null}}"
                                            CornerRadius="12"
                                            Padding="10,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                    </Border>

                                    <!-- Col 3: Groups -->
                                    <Border Grid.Column="3"
                                            Background="#F1F5F9"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GroupsText}" FontSize="11" Foreground="#334155" FontWeight="Medium" />
                                    </Border>

                                    <!-- Col 4: Action Buttons -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="🔑 Đổi pass"
                                                Command="{Binding $parent[UserControl].((vm:AdminPanelViewModel)DataContext).OpenResetPasswordDialogCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                FontSize="11"
                                                CornerRadius="4"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                Foreground="#334155" />

                                        <Button Content="{Binding ToggleActionText}"
                                                Command="{Binding $parent[UserControl].((vm:AdminPanelViewModel)DataContext).ToggleUserDisabledCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                FontSize="11"
                                                CornerRadius="4"
                                                Background="#F8FAFC"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                Foreground="{Binding StatusColor}"
                                                FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Table Footer: Summary Stats -->
                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4">
                        <TextBlock Text="{Binding TotalUsersCount, StringFormat='Tổng cộng: {0} tài khoản người dùng'}"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

            <!-- ============================================================ -->
            <!-- SECTION 2: GROUPS & MEMBERSHIP (MÔ HÌNH MASTER-DETAIL 2 CỘT) -->
            <!-- ============================================================ -->
            <Grid IsVisible="{Binding IsGroupsTabSelected}" RowDefinitions="Auto,*">
                    <!-- Actions Toolbar & Search -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*,260" VerticalAlignment="Center">
                            <Button Grid.Column="0"
                                    Content="➕ Tạo nhóm mới"
                                    Command="{Binding OpenCreateGroupDialogCommand}"
                                    Padding="14,7"
                                    Background="#7C3AED"
                                    Foreground="#FFFFFF"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    FontSize="12" />

                            <TextBlock Grid.Column="1"
                                       Text="Bố cục Master-Detail: Chọn một nhóm ở cột trái để quản lý và phân bổ thành viên ở cột phải."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding SearchGroupQuery, Mode=TwoWay}"
                                     PlaceholderText="🔍 Tìm tên nhóm..."
                                     Height="34"
                                     CornerRadius="6"
                                     BorderBrush="#CBD5E1"
                                     Padding="10,0"
                                     FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- Master-Detail 2-Column Layout -->
                    <Grid Grid.Row="1" ColumnDefinitions="340,16,*">
                        
                        <!-- COLUMN 1 (LEFT - MASTER): Groups Cards List -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6,6,0,0" Padding="14,10">
                                <TextBlock Text="DANH SÁCH NHÓM LÀM VIỆC" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding FilteredGroups}"
                                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1,0,1,1"
                                     CornerRadius="0,0,6,6"
                                     Background="#FFFFFF">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:UiGroupItem">
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#94A3B8" />
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#EDE9FE" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MemberCountText}" Foreground="#6D28D9" FontWeight="Bold" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- COLUMN 2 (RIGHT - DETAIL): Members in Selected Group -->
                        <Border Grid.Column="2"
                                Background="#FFFFFF"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <!-- Group Details Header Card -->
                                <Border Grid.Row="0"
                                        Background="#FAF5FF"
                                        BorderBrush="#E9D5FF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,0,0,14">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Thành viên của nhóm:" FontWeight="Bold" FontSize="14" Foreground="#581C87" />
                                                <TextBlock Text="{Binding SelectedGroup.Name}" FontWeight="Bold" FontSize="14" Foreground="#7C3AED" />
                                            </StackPanel>
                                            <TextBlock Text="Các thành viên này sẽ tự động thừa hưởng toàn bộ quyền hạn (Grants) được cấp cho nhóm."
                                                       FontSize="11"
                                                       Foreground="#6B21A8" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="➕ Thêm thành viên"
                                                Command="{Binding OpenAddMemberDialogCommand}"
                                                CommandParameter="{Binding SelectedGroup}"
                                                IsEnabled="{Binding HasSelectedGroup}"
                                                Padding="12,6"
                                                Background="#7C3AED"
                                                Foreground="#FFFFFF"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                CornerRadius="4" />
                                    </Grid>
                                </Border>

                                <Separator Grid.Row="1" Background="#E2E8F0" Margin="0,0,0,10" />

                                <!-- Members List of Selected Group -->
                                <ScrollViewer Grid.Row="2">
                                    <StackPanel Spacing="6">
                                        <!-- When a group is selected and has members -->
                                        <ItemsControl ItemsSource="{Binding SelectedGroup.Members}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="#F8FAFC"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,8"
                                                            Margin="0,2">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="{Binding}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" />

                                                            <Button Grid.Column="1"
                                                                    Content="🗑️ Xóa khỏi nhóm"
                                                                    Command="{Binding $parent[UserControl].((vm:AdminPanelViewModel)DataContext).RemoveMemberCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="10,4"
                                                                    FontSize="11"
                                                                    Background="#FEF2F2"
                                                                    Foreground="#E11D48"
                                                                    BorderBrush="#FECDD3"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty State Prompt when no group selected -->
                                        <Border Padding="20" HorizontalAlignment="Center" IsVisible="{Binding !HasSelectedGroup}">
                                            <TextBlock Text="← Vui lòng chọn một nhóm ở danh sách bên trái để quản lý thành viên."
                                                       FontSize="12"
                                                       Foreground="#94A3B8"
                                                       FontStyle="Italic" />
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            <!-- ============================================================ -->
            <!-- SECTION 3: GRANTS RBAC (PHÂN QUYỀN THƯ MỤC VÀ KẾ THỪA PHÂN CẤP)-->
            <!-- ============================================================ -->
            <Grid IsVisible="{Binding IsGrantsTabSelected}" RowDefinitions="Auto,Auto,*">
                    <!-- Actions Toolbar -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <Button Grid.Column="0"
                                    Content="➕ Cấp quyền mới (Grant)"
                                    Command="{Binding OpenCreateGrantDialogCommand}"
                                    Padding="14,7"
                                    Background="#0284C7"
                                    Foreground="#FFFFFF"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    FontSize="12" />

                            <TextBlock Grid.Column="1"
                                       Text="Chính sách RBAC: Quyền cấp trên thư mục cha (ví dụ '/projects') sẽ tự động kế thừa xuống các thư mục con."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Table Header -->
                    <Border Grid.Row="1"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6,6,0,0"
                            Padding="16,10">
                        <Grid ColumnDefinitions="2*,2.5*,2.5*,2.5*,2*,2*">
                            <TextBlock Grid.Column="0" Text="Grant ID" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="1" Text="Vai trò (Role)" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="2" Text="Đối tượng nhận quyền" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="3" Text="Đường dẫn áp dụng" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="4" Text="Nguồn gốc" FontWeight="Bold" FontSize="12" Foreground="#334155" />
                            <TextBlock Grid.Column="5" Text="Thao tác" FontWeight="Bold" FontSize="12" Foreground="#334155" TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Grants List -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Grants}"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1,0,1,1"
                             CornerRadius="0,0,6,6"
                             Background="#FFFFFF">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:UiGrantItem">
                                <Grid ColumnDefinitions="2*,2.5*,2.5*,2.5*,2*,2*" VerticalAlignment="Center" Margin="0,5">
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleId}" FontWeight="Bold" FontSize="11" Foreground="#0284C7" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Subject}" FontWeight="Medium" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding TargetPath}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

                                    <Button Grid.Column="5"
                                            Content="Thu hồi quyền"
                                            Command="{Binding $parent[UserControl].((vm:AdminPanelViewModel)DataContext).RevokeGrantCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            FontSize="11"
                                            CornerRadius="4"
                                            Background="#FEF2F2"
                                            Foreground="#E11D48"
                                            HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
        </Panel>

        <!-- ============================================================ -->
        <!-- MODAL OVERLAYS: Dialogs                                      -->
        <!-- ============================================================ -->

        <!-- MODAL OVERLAY: Create User Dialog -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsCreateUserDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="420"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="➕ Tạo tài khoản người dùng mới" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên đăng nhập:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUsername, Mode=TwoWay}" PlaceholderText="Ví dụ: nguyen.van.a" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Mật khẩu khởi tạo:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUserPassword, Mode=TwoWay}" PasswordChar="•" PlaceholderText="••••••••" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Nhóm gia nhập ban đầu:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUserGroup, Mode=TwoWay}" PlaceholderText="Ví dụ: Team A hoặc Guests" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy" Command="{Binding CancelCreateUserCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Tạo tài khoản" Command="{Binding ConfirmCreateUserCommand}" Padding="14,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Reset Password Dialog -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsResetPasswordDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="400"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="🔑 Đặt lại mật khẩu" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding SelectedUserForReset.Username, StringFormat='Nhập mật khẩu mới cho tài khoản: {0}'}" FontSize="12" Foreground="#64748B" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Mật khẩu mới:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewResetPassword, Mode=TwoWay}" PasswordChar="•" PlaceholderText="••••••••" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy" Command="{Binding CancelResetPasswordCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Lưu mật khẩu" Command="{Binding ConfirmResetPasswordCommand}" Padding="14,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Create Group Dialog -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsCreateGroupDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="380"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="➕ Tạo nhóm làm việc mới" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên nhóm mới:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewGroupName, Mode=TwoWay}" PlaceholderText="Ví dụ: Team B, Auditors, Devs" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy" Command="{Binding CancelCreateGroupCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Tạo nhóm" Command="{Binding ConfirmCreateGroupCommand}" Padding="14,6" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Add Member to Group Dialog -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsAddMemberDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="400"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="➕ Thêm thành viên vào nhóm" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding SelectedGroup.Name, StringFormat='Nhóm mục tiêu: {0}'}" FontSize="12" Foreground="#7C3AED" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên đăng nhập (Username):" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding AddMemberUsername, Mode=TwoWay}" PlaceholderText="Ví dụ: an.nguyen hoặc chọn từ danh sách" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy" Command="{Binding CancelAddMemberCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Thêm vào nhóm" Command="{Binding ConfirmAddMemberCommand}" Padding="14,6" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Create Grant Dialog -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsCreateGrantDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="440"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Cấp quyền truy cập mới (RBAC)" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Loại đối tượng nhận quyền (User hoặc Group):" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding GrantSubjectType, Mode=TwoWay}" PlaceholderText="User hoặc Group" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên hoặc ID đối tượng (Username / Group Name):" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding GrantSubjectId, Mode=TwoWay}" PlaceholderText="Ví dụ: Team A hoặc tan.phan" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Vai trò cấp (Role):" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding GrantRoleId, Mode=TwoWay}" PlaceholderText="Editor, Viewer, Admin, Owner" Height="36" CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Đường dẫn thư mục áp dụng (để trống nếu toàn cục):" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding GrantPath, Mode=TwoWay}" PlaceholderText="/projects" Height="36" CornerRadius="6" FontFamily="Consolas, monospace" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy" Command="{Binding CancelCreateGrantCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Xác nhận cấp quyền" Command="{Binding ConfirmCreateGrantCommand}" Padding="14,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
