<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             xmlns:m="using:Dfs.Client.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
             x:Class="Dfs.Client.Desktop.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">

    <Grid>
        <!-- Main Layout: 2 Columns (Tree Sidebar + Content Area) -->
        <Grid ColumnDefinitions="240,*">
            <!-- Left: Directory Tree Sidebar -->
            <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Tree Header -->
                    <Border Grid.Row="0"
                            Padding="16,12"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Background="#F1F5F9">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🌳" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="CÂY THƯ MỤC"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="#475569"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Directory TreeView -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding RootNodes}"
                              Padding="6"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="m:UiDirectoryNode">
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).SelectTreeNodeCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📁" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Right: Main Work Area -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="#FFFFFF">
                <!-- Row 0: Breadcrumb & Search Bar -->
                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid ColumnDefinitions="*,Auto,220" VerticalAlignment="Center">
                        <!-- Breadcrumbs or Manual Path Box -->
                        <Panel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Breadcrumb buttons strip -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding !IsManualPathMode}">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:UiBreadcrumbItem">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Content="{Binding Name}"
                                                        Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).NavigateBreadcrumbCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontWeight="Medium"
                                                        FontSize="12"
                                                        Foreground="#0284C7"
                                                        CornerRadius="4" />
                                                <TextBlock Text="/"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsLast}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Manual Path Input Box -->
                            <TextBox Text="{Binding CurrentPath, Mode=TwoWay}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     CornerRadius="4"
                                     BorderBrush="#CBD5E1"
                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                     FontSize="12"
                                     IsVisible="{Binding IsManualPathMode}" />
                        </Panel>

                        <!-- Toggle Path Edit Mode Button -->
                        <Button Grid.Column="1"
                                Content="✏️"
                                Command="{Binding TogglePathEditModeCommand}"
                                ToolTip.Tip="Chuyển đổi nhập đường dẫn trực tiếp"
                                Padding="8,4"
                                Margin="6,0,12,0"
                                Background="Transparent"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11" />

                        <!-- Search Box in Current Directory -->
                        <TextBox Grid.Column="2"
                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="🔍 Tìm kiếm tệp..."
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 CornerRadius="16"
                                 BorderBrush="#CBD5E1"
                                 Padding="10,0"
                                 FontSize="12" />
                    </Grid>
                </Border>

                <!-- Row 1: Action Toolbar -->
                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="⬆ Lên cấp"
                                Command="{Binding NavigateUpCommand}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                FontSize="12" />

                        <Separator Background="#E2E8F0" Width="1" Margin="4,2" />

                        <Button Content="📁+ Thư mục mới"
                                Command="{Binding OpenCreateFolderDialogCommand}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                FontSize="12" />

                        <Button Content="⬇ Tải xuống"
                                Command="{Binding DownloadItemCommand}"
                                IsEnabled="{Binding CanDownload}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Foreground="#0284C7"
                                FontWeight="SemiBold"
                                FontSize="12" />

                        <Button Content="✏️ Đổi tên"
                                Command="{Binding OpenRenameDialogCommand}"
                                IsEnabled="{Binding CanDeleteOrRename}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                FontSize="12" />

                        <Button Content="✂️ Di chuyển"
                                Command="{Binding OpenMoveDialogCommand}"
                                IsEnabled="{Binding CanDeleteOrRename}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                FontSize="12" />

                        <Button Content="🗑️ Xóa"
                                Command="{Binding OpenDeleteDialogCommand}"
                                IsEnabled="{Binding CanDeleteOrRename}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#FFF5F5"
                                BorderBrush="#FECDD3"
                                BorderThickness="1"
                                Foreground="#E11D48"
                                FontSize="12" />

                        <Separator Background="#E2E8F0" Width="1" Margin="4,2" />

                        <Button Content="🔄 Làm mới (F5)"
                                Command="{Binding RefreshCommand}"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#0284C7"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Row 2: Notification Banner -->
                <Border Grid.Row="2"
                        IsVisible="{Binding HasNotification}"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding NotificationMessage}"
                                   Foreground="#065F46"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding DismissNotificationCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#065F46"
                                Padding="6,2" />
                    </Grid>
                </Border>

                <!-- Row 3: File Items Table -->
                <Grid Grid.Row="3" RowDefinitions="Auto,*">
                    <!-- Column Header -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <Grid ColumnDefinitions="3*,1*,1*,1.2*,1.8*">
                            <TextBlock Grid.Column="0" Text="Tên tệp / thư mục" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                            <TextBlock Grid.Column="1" Text="Kích thước" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                            <TextBlock Grid.Column="2" Text="Phiên bản" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                            <TextBlock Grid.Column="3" Text="Chủ sở hữu" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                            <TextBlock Grid.Column="4" Text="Sửa đổi lần cuối" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:UiFileItem">
                                <Grid ColumnDefinitions="3*,1*,1*,1.2*,1.8*"
                                      VerticalAlignment="Center"
                                      Margin="0,3">
                                    <!-- Context Menu on Right Click -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📁 Mở thư mục"
                                                      IsVisible="{Binding IsFolder}"
                                                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).OpenItemCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="⬇ Tải xuống (Download)"
                                                      IsVisible="{Binding !IsFolder}"
                                                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).DownloadItemCommand}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="✏️ Đổi tên (F2)"
                                                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).OpenRenameDialogCommand}" />
                                            <MenuItem Header="✂️ Di chuyển (Ctrl+X)..."
                                                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).OpenMoveDialogCommand}" />
                                            <Separator />
                                            <MenuItem Header="ℹ️ Thuộc tính chi tiết..."
                                                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).OpenPropertiesDialogCommand}" />
                                            <Separator />
                                            <MenuItem Header="🗑️ Xóa vĩnh viễn (Del)"
                                                      Foreground="#E11D48"
                                                      Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).OpenDeleteDialogCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Name & Icon (Click to open folder or download file) -->
                                    <Button Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[UserControl].((vm:FileBrowserViewModel)DataContext).OpenItemCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="{Binding IsFolder, Converter={x:Null}}"
                                                       Foreground="#1E293B"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="1" Text="{Binding SizeString}"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               FontSize="12" />

                                    <!-- Version -->
                                    <TextBlock Grid.Column="2" Text="{Binding VersionString}"
                                               VerticalAlignment="Center"
                                               Foreground="#0284C7"
                                               FontWeight="SemiBold"
                                               FontSize="12" />

                                    <!-- Owner -->
                                    <TextBlock Grid.Column="3" Text="{Binding OwnerString}"
                                               VerticalAlignment="Center"
                                               Foreground="#334155"
                                               FontSize="12" />

                                    <!-- Modified -->
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedString}"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Illustration -->
                    <StackPanel Grid.Row="1"
                                IsVisible="{Binding IsEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" />
                        <TextBlock Text="Thư mục hiện tại đang trống"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Bạn có thể tạo thư mục mới hoặc tải lên tệp tin từ thanh công cụ phía trên."
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Row 4: Status Bar & Hint -->
                <Border Grid.Row="4"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusText}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="💡 Nhấp chuột để mở thư mục / tải file"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   FontStyle="Italic"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center" />

                        <ProgressBar Grid.Column="2"
                                     IsIndeterminate="True"
                                     Width="80" Height="4"
                                     IsVisible="{Binding IsLoading}"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- MODAL OVERLAY: Create Folder Dialog -->
        <Border Background="#80000000"
                IsVisible="{Binding IsCreateFolderDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="380"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="📁 Tạo thư mục mới" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="Nhập tên cho thư mục mới:" FontSize="12" Foreground="#64748B" />
                    <TextBox Text="{Binding NewFolderName, Mode=TwoWay}" PlaceholderText="Ví dụ: docs, reports, source" Height="36" CornerRadius="6" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Hủy" Command="{Binding CancelCreateFolderCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Tạo mới" Command="{Binding ConfirmCreateFolderCommand}" Padding="14,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Rename Dialog -->
        <Border Background="#80000000"
                IsVisible="{Binding IsRenameDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="380"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="✏️ Đổi tên tệp / thư mục" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="Nhập tên mới:" FontSize="12" Foreground="#64748B" />
                    <TextBox Text="{Binding RenameNewName, Mode=TwoWay}" Height="36" CornerRadius="6" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Hủy" Command="{Binding CancelRenameCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Lưu thay đổi" Command="{Binding ConfirmRenameCommand}" Padding="14,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Delete Dialog -->
        <Border Background="#80000000"
                IsVisible="{Binding IsDeleteDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="400"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="🗑️ Xác nhận xóa vĩnh viễn" FontSize="16" FontWeight="Bold" Foreground="#E11D48" />
                    <TextBlock Text="{Binding DeletePromptMessage}" FontSize="13" TextWrapping="Wrap" Foreground="#1E293B" />
                    <TextBlock Text="Hành động này không thể hoàn tác sau khi thực hiện!" FontSize="11" Foreground="#94A3B8" FontStyle="Italic" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Không xóa" Command="{Binding CancelDeleteCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Đồng ý xóa" Command="{Binding ConfirmDeleteCommand}" Padding="14,6" Background="#E11D48" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Move Dialog -->
        <Border Background="#80000000"
                IsVisible="{Binding IsMoveDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="420"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="✂️ Di chuyển mục đã chọn" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="Nhập đường dẫn thư mục đích đến:" FontSize="12" Foreground="#64748B" />
                    <TextBox Text="{Binding MoveTargetPath, Mode=TwoWay}" PlaceholderText="Ví dụ: /projects/dfs hoặc /shared" Height="36" CornerRadius="6" FontFamily="Consolas, monospace" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Hủy" Command="{Binding CancelMoveCommand}" Padding="14,6" Background="#F1F5F9" CornerRadius="4" />
                        <Button Content="Di chuyển" Command="{Binding ConfirmMoveCommand}" Padding="14,6" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- MODAL OVERLAY: Item Properties Dialog -->
        <Border Background="#80000000"
                IsVisible="{Binding IsPropertiesDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="450"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="ℹ️ Thuộc tính chi tiết" FontSize="16" FontWeight="Bold" Foreground="#1E293B" />

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên tệp:" FontWeight="SemiBold" FontSize="12" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.Name}" FontSize="12" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Đường dẫn:" FontWeight="SemiBold" FontSize="12" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Path}" FontFamily="Consolas, monospace" FontSize="12" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Kích thước:" FontWeight="SemiBold" FontSize="12" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.SizeString}" FontSize="12" Margin="0,4" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Phiên bản:" FontWeight="SemiBold" FontSize="12" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.VersionString}" FontWeight="Bold" Foreground="#0284C7" FontSize="12" Margin="0,4" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Chủ sở hữu:" FontWeight="SemiBold" FontSize="12" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.OwnerString}" FontSize="12" Margin="0,4" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Sửa đổi lần cuối:" FontWeight="SemiBold" FontSize="12" Margin="0,4,16,4" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.ModifiedString}" FontSize="12" Margin="0,4" />
                    </Grid>

                    <Button Content="Đóng" Command="{Binding ClosePropertiesDialogCommand}" Padding="16,6" Background="#F1F5F9" CornerRadius="4" HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
