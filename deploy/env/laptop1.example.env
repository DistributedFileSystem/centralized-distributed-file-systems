# Copy to deploy/env/laptop1.env and replace placeholders before running.
# Never commit deploy/env/laptop1.env (ignored by .gitignore).

# Laptop 1 runs both Metadata Server and Data Server in Stage 1.
COMPOSE_PROFILES=metadata,data

# Bind published ports on all interfaces so peer laptops can connect.
BIND_HOST=0.0.0.0

# Static LAN IP of Laptop 1 advertised to clients and peer nodes.
ADVERTISE_HOST=192.168.10.11

# Metadata Server settings
METADATA_NODE_ID=m1
METADATA_LISTEN_PORT=7000

# Data Server settings
DATA_NODE_ID=ds-1
DATA_LISTEN_PORT=7001

# Metadata Server endpoint(s): use Compose DNS first on Laptop 1 to avoid hairpin NAT, with LAN IP fallback
METADATA_ENDPOINTS=metadata:7000,192.168.10.11:7000

# Shared HMAC key for data tokens (must be identical on all 5 laptops)
TOKEN_KEY=replace-with-shared-cluster-token-key

# Initial admin credentials (used on first Metadata Server boot)
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-initial-admin-password

# Metadata retention & snapshot settings
KEEP_VERSIONS=5
SNAPSHOT_INTERVAL_OPS=100

# Optional Data Server storage capacity limit in bytes (0 = auto/unlimited)
CAPACITY_BYTES=0
