<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             xmlns:m="using:Dfs.Client.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
             x:Class="Dfs.Client.Desktop.Views.TransferManagerView"
             x:DataType="vm:TransferManagerViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Background="#FFFFFF" Margin="16,14,16,12">
        <!-- 1. Header & Actions Toolbar (Adaptive layout) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="🚀 Hàng đợi truyền tải (Transfer Manager)"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           TextWrapping="Wrap" />
                <TextBlock Text="Theo dõi tiến độ Upload / Download đa khối song song trực tiếp với các Data Server"
                           FontSize="11"
                           Foreground="#64748B"
                           TextWrapping="Wrap" />
            </StackPanel>

            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⬆ Tải lên tệp mới..."
                        Command="{Binding OpenUploadDialogCommand}"
                        Padding="12,6"
                        Margin="0,2,8,2"
                        CornerRadius="6"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        FontSize="12" />

                <Button Content="🧹 Xóa hoàn tất"
                        Command="{Binding ClearCompletedCommand}"
                        Padding="12,6"
                        Margin="0,2,0,2"
                        CornerRadius="6"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        FontSize="12" />
            </WrapPanel>
        </Grid>

        <!-- 2. Top Metrics Summary Bar (Adaptive WrapPanel - theo wireframe 03-transfers.md) -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <Border MinWidth="120" Margin="4,2,16,2">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TỐC ĐỘ TỔNG" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding TotalSpeedText}" FontSize="16" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                </Border>

                <Border MinWidth="120" Margin="4,2,16,2">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ĐANG HOẠT ĐỘNG" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding ActiveCountText}" FontSize="16" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                </Border>

                <Border MinWidth="150" Margin="4,2,16,2">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GIAO THỨC" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="Raw TCP (Chunks 4MB)" FontSize="13" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border MinWidth="130" Margin="4,2,4,2">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TÍNH TOÀN VẸN" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="SHA-256 Verified" FontSize="13" FontWeight="SemiBold" Foreground="#059669" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- 3. Unavailable Alert Banner -->
        <Border Grid.Row="2"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12"
                IsVisible="{Binding HasUnavailableAlert}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🚨" FontSize="15" />
                    <TextBlock Text="{Binding UnavailableAlert}"
                               Foreground="#991B1B"
                               FontWeight="SemiBold"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding DismissAlertCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#991B1B"
                        Padding="6,2" />
            </Grid>
        </Border>

        <!-- 4. Filter Tabs (Adaptive WrapPanel) -->
        <Border Grid.Row="3"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{Binding AllFilterHeader}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="all"
                        Padding="12,5"
                        Margin="2"
                        CornerRadius="4"
                        Background="{Binding IsAllFilter, Converter={x:Null}}"
                        FontWeight="SemiBold"
                        FontSize="12" />

                <Button Content="{Binding ActiveFilterHeader}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="active"
                        Padding="12,5"
                        Margin="2"
                        CornerRadius="4"
                        Background="{Binding IsActiveFilter, Converter={x:Null}}"
                        FontWeight="SemiBold"
                        FontSize="12" />

                <Button Content="{Binding CompletedFilterHeader}"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="completed"
                        Padding="12,5"
                        Margin="2"
                        CornerRadius="4"
                        Background="{Binding IsCompletedFilter, Converter={x:Null}}"
                        FontWeight="SemiBold"
                        FontSize="12" />
            </WrapPanel>
        </Border>

        <!-- 5. Transfer Cards List -->
        <Grid Grid.Row="4">
            <Border Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !Transfers.Count}">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="Chưa có tác vụ truyền tải nào"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Các tác vụ Tải lên (Upload) hoặc Tải xuống (Download) từ Trình duyệt tệp sẽ xuất hiện tại đây."
                               FontSize="12"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer IsVisible="{Binding Transfers.Count}">
                <ItemsControl ItemsSource="{Binding FilteredTransfers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:UiTransferItem">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    Margin="0,0,0,10"
                                    BoxShadow="0 2 8 0 #0A000000">
                                <StackPanel Spacing="8">
                                    <!-- Row 1: Direction Badge, File Name (trimmable), Speed & Action Buttons (never clipped) -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Direction Badge -->
                                        <Border Grid.Column="0"
                                                Background="#EFF6FF"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Direction}"
                                                       Foreground="#0284C7"
                                                       FontWeight="Bold"
                                                       FontSize="11" />
                                        </Border>

                                        <!-- File Name -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="#1E293B"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- Speed + Action Buttons (right aligned) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Speed}"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="#0284C7"
                                                       VerticalAlignment="Center" />

                                            <Button Content="✕ Hủy"
                                                    Command="{Binding $parent[UserControl].((vm:TransferManagerViewModel)DataContext).CancelTransferCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanCancel}"
                                                    Padding="8,4"
                                                    CornerRadius="4"
                                                    Background="#FEF2F2"
                                                    BorderBrush="#FECDD3"
                                                    BorderThickness="1"
                                                    Foreground="#E11D48"
                                                    FontWeight="SemiBold"
                                                    FontSize="11" />

                                            <Button Content="↻ Thử lại"
                                                    Command="{Binding $parent[UserControl].((vm:TransferManagerViewModel)DataContext).RetryTransferCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanRetry}"
                                                    Padding="8,4"
                                                    CornerRadius="4"
                                                    Background="#ECFDF5"
                                                    BorderBrush="#A7F3D0"
                                                    BorderThickness="1"
                                                    Foreground="#059669"
                                                    FontWeight="SemiBold"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Destination Path and Size Text (reflow, trimmable) -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DestinationPath, StringFormat='Đích: {0}'}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B" />
                                    </Grid>

                                    <!-- Row 3: Progress Bar + Percentage -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,2,0,0">
                                        <ProgressBar Grid.Column="0"
                                                     Value="{Binding Progress}"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Height="8"
                                                     CornerRadius="4"
                                                     Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FormattedProgress}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#1E293B"
                                                   Width="42"
                                                   TextAlignment="Right" />
                                    </Grid>

                                    <!-- Row 4: Status Details & Target Servers (adaptive WrapPanel) -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="#334155" />
                                        <TextBlock Text=" • " Foreground="#CBD5E1" Margin="2,0" />
                                        <TextBlock Text="{Binding TargetServers}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap" />
                                    </WrapPanel>

                                    <!-- Row 5: Chunk breakdown expander (wireframe 03-transfers.md) -->
                                    <Expander Header="Chi tiết phân tán các Chunk 4 MB tới 5 Data Server..."
                                              FontSize="11"
                                              Foreground="#0284C7"
                                              Margin="0,2,0,0">
                                        <ItemsControl ItemsSource="{Binding Chunks}" Margin="4,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:UiChunkItem">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,3">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding ChunkIndex, StringFormat='Chunk {0}:'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ChunkSize}"
                                                                   FontSize="11"
                                                                   Foreground="#64748B"
                                                                   Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DataServer, StringFormat='→ {0}'}"
                                                                   FontSize="11"
                                                                   Foreground="#1E293B"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Status}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Foreground="#059669" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- MODAL OVERLAY: New Upload Dialog (Adaptive MaxWidth) -->
        <Border Grid.RowSpan="5"
                Background="#80000000"
                IsVisible="{Binding IsUploadDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    MaxWidth="440"
                    Margin="16"
                    Padding="20"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="⬆ Tải tệp tin mới lên hệ thống DFS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1E293B" />
                    <TextBlock Text="Hệ thống sẽ tự động băm SHA-256 và phân mảnh 4 MB tới 5 Data Server trong mạng LAN."
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên tệp tin tải lên:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUploadFileName, Mode=TwoWay}"
                                 PlaceholderText="Ví dụ: research_paper.pdf"
                                 Height="36"
                                 CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Đường dẫn thư mục đích trên DFS:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUploadPath, Mode=TwoWay}"
                                 PlaceholderText="/projects/dfs"
                                 Height="36"
                                 CornerRadius="6"
                                 FontFamily="Consolas, monospace" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy"
                                Command="{Binding CancelUploadDialogCommand}"
                                Padding="14,6"
                                Background="#F1F5F9"
                                CornerRadius="4" />
                        <Button Content="Bắt đầu tải lên"
                                Command="{Binding ConfirmUploadCommand}"
                                Padding="14,6"
                                Background="#0284C7"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
