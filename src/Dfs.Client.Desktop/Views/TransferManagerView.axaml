<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             xmlns:m="using:Dfs.Client.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="700"
             x:Class="Dfs.Client.Desktop.Views.TransferManagerView"
             x:DataType="vm:TransferManagerViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="#FFFFFF" Margin="24">
        <!-- 1. Header & Actions Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="🚀 Hàng đợi truyền tải (Transfer Manager)"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#212529" />
                <TextBlock Text="Giám sát tiến độ Upload / Download song song qua socket TCP tới 5 Data Server trong mạng LAN"
                           FontSize="12"
                           Foreground="#6C757D" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="⬆ Tải lên tệp mới..."
                        Command="{Binding OpenUploadDialogCommand}"
                        Padding="12,6"
                        CornerRadius="4"
                        Background="#0066CC"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        FontSize="12" />

                <Button Content="⚡ Mô phỏng lỗi Unavailable"
                        Command="{Binding SimulateUnavailableCommand}"
                        Padding="12,6"
                        CornerRadius="4"
                        Background="#FFF3CD"
                        BorderBrush="#FFEEBA"
                        BorderThickness="1"
                        Foreground="#856404"
                        FontSize="12" />

                <Button Content="🧹 Xóa hoàn tất"
                        Command="{Binding ClearCompletedCommand}"
                        Padding="12,6"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        BorderBrush="#DEE2E6"
                        BorderThickness="1"
                        FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- 2. Unavailable Alert Banner -->
        <Border Grid.Row="1"
                Background="#F8D7DA"
                BorderBrush="#F5C6CB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,14"
                IsVisible="{Binding HasUnavailableAlert}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🚨" FontSize="16" />
                    <TextBlock Text="{Binding UnavailableAlert}"
                               Foreground="#721C24"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✖"
                        Command="{Binding DismissAlertCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#721C24"
                        Padding="6,2" />
            </Grid>
        </Border>

        <!-- 3. Filter Tabs -->
        <Border Grid.Row="2"
                Background="#F8F9FA"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6,4"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Tất cả tác vụ"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="all"
                        Padding="12,6"
                        CornerRadius="4"
                        Background="{Binding IsAllFilter, Converter={x:Null}}"
                        Foreground="{Binding IsAllFilter, Converter={x:Null}}"
                        FontWeight="SemiBold"
                        FontSize="12" />

                <Button Content="Đang truyền"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="active"
                        Padding="12,6"
                        CornerRadius="4"
                        Background="{Binding IsActiveFilter, Converter={x:Null}}"
                        Foreground="{Binding IsActiveFilter, Converter={x:Null}}"
                        FontWeight="SemiBold"
                        FontSize="12" />

                <Button Content="Hoàn tất"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="completed"
                        Padding="12,6"
                        CornerRadius="4"
                        Background="{Binding IsCompletedFilter, Converter={x:Null}}"
                        Foreground="{Binding IsCompletedFilter, Converter={x:Null}}"
                        FontWeight="SemiBold"
                        FontSize="12" />
            </StackPanel>
        </Border>

        <!-- 4. Transfer Cards List -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding FilteredTransfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:UiTransferItem">
                        <Border Background="#FFFFFF"
                                BorderBrush="#DEE2E6"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12"
                                BoxShadow="0 2 6 0 #08000000">
                            <StackPanel Spacing="10">
                                <!-- Line 1: Direction Badge, File Name, Speed, Cancel/Retry Button -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <!-- Direction Badge -->
                                    <Border Grid.Column="0"
                                            Background="#E7F5FF"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Direction}"
                                                   Foreground="#0066CC"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                    </Border>

                                    <!-- File Name & Destination -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="#212529"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DestinationPath, StringFormat='Đường dẫn: {0}'}"
                                                   FontSize="11"
                                                   Foreground="#6C757D" />
                                    </StackPanel>

                                    <!-- Speed text -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Speed}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0066CC"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Cancel Button -->
                                        <Button Content="✕ Hủy"
                                                Command="{Binding $parent[UserControl].((vm:TransferManagerViewModel)DataContext).CancelTransferCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanCancel}"
                                                Padding="10,4"
                                                CornerRadius="4"
                                                Background="#FFF5F5"
                                                BorderBrush="#FFC9C9"
                                                BorderThickness="1"
                                                Foreground="#DC3545"
                                                FontWeight="SemiBold"
                                                FontSize="11" />

                                        <!-- Retry Button -->
                                        <Button Content="↻ Thử lại"
                                                Command="{Binding $parent[UserControl].((vm:TransferManagerViewModel)DataContext).RetryTransferCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanRetry}"
                                                Padding="10,4"
                                                CornerRadius="4"
                                                Background="#EBFBEE"
                                                BorderBrush="#B2F2BB"
                                                BorderThickness="1"
                                                Foreground="#28A745"
                                                FontWeight="SemiBold"
                                                FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <!-- Line 2: Progress Bar -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <ProgressBar Grid.Column="0"
                                                 Value="{Binding Progress}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="10"
                                                 CornerRadius="5"
                                                 Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FormattedProgress}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#212529"
                                               Width="45"
                                               TextAlignment="Right" />
                                </Grid>

                                <!-- Line 3: Status Details & Size -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#495057" />
                                        <TextBlock Text="•" Foreground="#CED4DA" />
                                        <TextBlock Text="{Binding TargetServers}"
                                                   FontSize="11"
                                                   Foreground="#6C757D" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#6C757D" />
                                </Grid>

                                <!-- Line 4: Chunk breakdown expander -->
                                <Expander Header="Xem chi tiết phân mảnh 4 MB tới các Data Server..."
                                          FontSize="11"
                                          Foreground="#0066CC"
                                          Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Chunks}" Margin="8,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:UiChunkItem">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ChunkIndex, StringFormat='Chunk {0}:'}"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ChunkSize}"
                                                               FontSize="11"
                                                               Foreground="#6C757D"
                                                               Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DataServer, StringFormat='→ {0}'}"
                                                               FontSize="11"
                                                               Foreground="#212529" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Status}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="#0066CC" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- MODAL OVERLAY: New Upload Dialog -->
        <Border Grid.RowSpan="4"
                Background="#80000000"
                IsVisible="{Binding IsUploadDialogOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#FFFFFF"
                    CornerRadius="8"
                    Width="440"
                    Padding="24"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="⬆ Tải tệp tin mới lên hệ thống DFS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#212529" />
                    <TextBlock Text="Hệ thống sẽ tự động băm SHA-256 và phân mảnh 4 MB tới 5 Data Server trong mạng LAN."
                               FontSize="12"
                               Foreground="#6C757D" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên tệp tin tải lên:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUploadFileName, Mode=TwoWay}"
                                 PlaceholderText="Ví dụ: research_paper.pdf"
                                 Height="34"
                                 CornerRadius="4" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Đường dẫn thư mục đích trên DFS:" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding NewUploadPath, Mode=TwoWay}"
                                 PlaceholderText="/projects/dfs"
                                 Height="34"
                                 CornerRadius="4"
                                 FontFamily="Consolas, Cascadia Mono, monospace" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Hủy"
                                Command="{Binding CancelUploadDialogCommand}"
                                Padding="14,6"
                                Background="#F1F3F5"
                                CornerRadius="4" />
                        <Button Content="Bắt đầu tải lên"
                                Command="{Binding ConfirmUploadCommand}"
                                Padding="14,6"
                                Background="#0066CC"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
