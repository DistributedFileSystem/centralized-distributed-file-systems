<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="650"
             x:Class="Dfs.Client.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="#F1F5F9">
        <Border Width="460"
                Padding="36,32"
                Background="#FFFFFF"
                CornerRadius="10"
                BoxShadow="0 10 30 0 #25000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <!-- App Logo & Title -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🗄️" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0284C7"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Centralized Distributed File System (DFS) - v1.0.0"
                               FontSize="12"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Separator Margin="0,2" Background="#E2E8F0" />

                <!-- Error Banner -->
                <Border Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="#991B1B"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding DismissErrorCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#991B1B"
                                Padding="4,0"
                                VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- Username Field -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Tên đăng nhập:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E293B" />
                    <TextBox Text="{Binding Username}"
                             PlaceholderText="demo"
                             Height="38"
                             CornerRadius="6"
                             BorderBrush="#CBD5E1"
                             IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <!-- Password Field with Show/Hide toggle -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Mật khẩu:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E293B" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Password}"
                                 PasswordChar="{Binding PasswordChar}"
                                 PlaceholderText="••••••••"
                                 Height="38"
                                 CornerRadius="6,0,0,6"
                                 BorderBrush="#CBD5E1"
                                 IsEnabled="{Binding !IsBusy}" />
                        <Button Grid.Column="1"
                                Content="{Binding RevealButtonText}"
                                Command="{Binding TogglePasswordRevealCommand}"
                                Height="38"
                                Padding="10,0"
                                CornerRadius="0,6,6,0"
                                Background="#F1F5F9"
                                BorderBrush="#CBD5E1"
                                BorderThickness="0,1,1,1"
                                FontSize="11"
                                VerticalContentAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- Metadata Server Endpoint Field -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Máy chủ Metadata (IP:Port):"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E293B" />
                    <TextBox Text="{Binding Endpoint}"
                             PlaceholderText="127.0.0.1:7000"
                             Height="38"
                             CornerRadius="6"
                             BorderBrush="#CBD5E1"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <!-- Options Row: Remember Me & Quick Demo Fill -->
                <Grid ColumnDefinitions="*,Auto">
                    <CheckBox Grid.Column="0"
                              Content="Ghi nhớ tên đăng nhập"
                              IsChecked="{Binding RememberMe}"
                              FontSize="12"
                              Foreground="#475569"
                              IsEnabled="{Binding !IsBusy}" />

                    <Button Grid.Column="1"
                            Content="⚡ Điền Demo (demo/demo)"
                            Command="{Binding FillDemoAccountCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Background="#EFF6FF"
                            Foreground="#0284C7"
                            BorderThickness="0"
                            CornerRadius="4"
                            FontWeight="SemiBold" />
                </Grid>

                <!-- Submit Button -->
                <Button Content="ĐĂNG NHẬP"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Height="42"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        FontWeight="Bold"
                        FontSize="13"
                        CornerRadius="6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,4,0,0" />

                <!-- Loading Indicator -->
                <StackPanel Spacing="4" IsVisible="{Binding IsBusy}">
                    <TextBlock Text="Đang kết nối tới máy chủ Metadata..."
                               FontSize="11"
                               Foreground="#0284C7"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
