# Copy to deploy/.env (or pass via --env-file) for local single-machine cluster.
# Never commit real secrets.

# Enable both profiles by default when running all 6 services (1 metadata + 5 data).
# Override on CLI with `--profile metadata` or `--profile data` when developing a single role.
COMPOSE_PROFILES=metadata,data

# Shared HMAC key for data tokens (replace with a strong random value locally)
TOKEN_KEY=replace-with-local-dev-token-key

# Initial admin credentials (used on first Metadata Server boot)
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-local-dev-admin-password

# Host address advertised to native clients on the same machine
METADATA_ADVERTISE_HOST=127.0.0.1
DATA_ADVERTISE_HOST=127.0.0.1
