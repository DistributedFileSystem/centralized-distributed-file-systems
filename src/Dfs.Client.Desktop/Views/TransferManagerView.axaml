<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Dfs.Client.Desktop.ViewModels"
             xmlns:m="using:Dfs.Client.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Dfs.Client.Desktop.Views.TransferManagerView"
             x:DataType="vm:TransferManagerViewModel">

    <Grid RowDefinitions="Auto,*" Background="#FFFFFF" Margin="24">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Hàng đợi truyền tải (Transfer Manager)"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#212529" />
                <TextBlock Text="Giám sát tiến độ Upload / Download song song trực tiếp với các Data Server"
                           FontSize="12"
                           Foreground="#6C757D" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="🧹 Xóa hoàn tất"
                    Command="{Binding ClearCompletedCommand}"
                    Padding="12,6"
                    CornerRadius="4"
                    Background="#FFFFFF"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1" />
        </Grid>

        <!-- Transfer Items List -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Transfers}"
                 Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:UiTransferItem">
                    <Border Background="#F8F9FA"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,4,0,8">
                        <StackPanel Spacing="8">
                            <!-- Row 1: File name & Badges -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#212529"
                                               VerticalAlignment="Center" />
                                    <Border Background="#E7F5FF"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Direction}"
                                                   Foreground="#0066CC"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Speed}"
                                           FontSize="12"
                                           Foreground="#6C757D"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Row 2: Progress Bar -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <ProgressBar Grid.Column="0"
                                             Value="{Binding Progress}"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="8"
                                             CornerRadius="4"
                                             Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FormattedProgress}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="#0066CC"
                                           Width="40"
                                           TextAlignment="Right" />
                            </Grid>

                            <!-- Row 3: Details -->
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Status}"
                                           FontSize="12"
                                           Foreground="#495057" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TargetServers, StringFormat='Data Servers: {0}'}"
                                           FontSize="11"
                                           Foreground="#6C757D"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
